{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/integrations/mcp/node_modules/@playwright/mcp/cli.js"
      ]
    },
    "firecrawl": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/integrations/mcp/node_modules/firecrawl-mcp/dist/index.js"
      ]
    },
    "vercel": {
      "type": "streamable-http",
      "url": "https://mcp.vercel.com"
    },
    "graphify": {
      "type": "stdio",
      "command": "graphify-mcp",
      "args": [
        "${PLUGIN_DATA}/graphify-out/graph.json"
      ]
    }
  }
}
