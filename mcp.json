{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "${PLUGIN_ROOT}/.tkstack/runtime/current/bin/playwright-mcp"
      ]
    },
    "firecrawl": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "${PLUGIN_ROOT}/.tkstack/runtime/current/bin/firecrawl-mcp"
      ]
    },
    "vercel": {
      "type": "streamable-http",
      "url": "https://mcp.vercel.com"
    },
    "graphify": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "${PLUGIN_ROOT}/.tkstack/runtime/current/bin/graphify-mcp",
        "${PLUGIN_DATA}/graphify-out/graph.json"
      ]
    }
  }
}
