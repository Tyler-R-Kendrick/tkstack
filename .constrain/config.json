{
  "version": 1,
  "tests": {
    "include": [
      "tests/test_*.py"
    ],
    "exclude": [],
    "max_cases": 445,
    "max_bytes": 445000,
    "reviews": ".constrain/reviews.json",
    "exceptions": [
      {
        "rule": "tests.no-oracle",
        "path": "tests/test_command_schema.py:CommandSchemaTests.test_builtin_version_validation_rejects_workflow_binding_and_bad_metadata",
        "reason": "self.cli checks the actual process exit for each malformed version contract; assertion lives in the shared CLI helper."
      }
    ]
  },
  "layout": {
    "budgets": [
      {
        "id": "tests",
        "include": [
          "tests/**"
        ],
        "exclude": [],
        "max_files": 35,
        "max_bytes": 450000,
        "max_depth": 2,
        "reason": "The Git experiment foundation adds five reviewed suites for scoped Git lifecycle, SQLite budgets, frozen-tree execution, evaluation, and bounded models, with room for its proof regressions."
      },
      {
        "id": "documentation",
        "include": [
          "docs/**"
        ],
        "exclude": [],
        "max_files": 51,
        "max_bytes": 545000,
        "max_depth": 3,
        "reason": "Keep one canonical feature document; allow reviewed ledger growth for the added Testify package, safety checks, type-first guidance and their existing owner pages."
      },
      {
        "id": "shared-code",
        "include": [
          "src/**",
          "scripts/**"
        ],
        "exclude": [],
        "max_files": 10,
        "max_bytes": 90000,
        "max_depth": 2,
        "reason": "Shared entrypoints only; constraint algorithms live inside the constrain skill."
      },
      {
        "id": "constraint-policy",
        "include": [
          ".constrain/**"
        ],
        "exclude": [],
        "max_files": 2,
        "max_bytes": 26000,
        "max_depth": 2,
        "reason": "Retain one policy and one per-suite review inventory, including the individually reviewed experiment foundation suites."
      },
      {
        "id": "owned-tree",
        "include": [
          "*"
        ],
        "exclude": [
          "vendor/**"
        ],
        "max_files": 836,
        "max_bytes": 8100000,
        "max_depth": 9,
        "reason": "The experiment foundation adds Git, ledger, evaluation, runner, and formal-model sources with their scoped regressions to the prior owned tree."
      }
    ]
  },
  "artifacts": [],
  "execution": {
    "max_jobs": 1,
    "max_timeout_minutes": 15
  },
  "documents": {
    "include": [
      "docs/*.md",
      "skills/constrain/references/*.md"
    ],
    "exclude": []
  },
  "boundaries": [
    {
      "id": "constrain-offline-scanners",
      "include": [
        "skills/constrain/scripts/constrain.py",
        "skills/constrain/scripts/dependencies.py",
        "skills/constrain/scripts/boundaries.py"
      ],
      "forbid_imports": [
        "socket",
        "urllib",
        "requests"
      ],
      "forbid_calls": [
        "eval",
        "exec",
        "os.system"
      ]
    }
  ]
}
