{
  "version": 1,
  "name": "flowify",
  "purpose": "Author workflows in a real DSL with explicit deterministic bindings and native validation boundaries.",
  "criteria": [
    {
      "id": "native-dialect",
      "description": "Use a real supported MAF/Rhai/existing native workflow dialect."
    },
    {
      "id": "dataflow",
      "description": "Define bound code, inputs/outputs, dependency ordering, concurrency and failure ownership."
    },
    {
      "id": "execution-boundary",
      "description": "Distinguish source inspection, native validation and actual observed execution."
    }
  ],
  "facts_schema": {
    "type": "object",
    "properties": {
      "dialect": {
        "type": "string",
        "enum": [
          "maf",
          "rhai",
          "existing"
        ]
      },
      "claim_executed": {
        "type": "boolean"
      },
      "execution_observed": {
        "type": "boolean"
      },
      "bindings_explicit": {
        "type": "boolean",
        "const": true
      }
    },
    "required": [
      "dialect",
      "claim_executed",
      "execution_observed",
      "bindings_explicit"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "claim_executed": {
              "const": true
            }
          }
        },
        "then": {
          "properties": {
            "execution_observed": {
              "const": true
            }
          }
        }
      }
    ]
  },
  "native": {
    "native_scaffold": {
      "entrypoint": "scripts/flowify.py",
      "prefix": [
        "scaffold"
      ],
      "parameters": {
        "backend": {
          "schema": {
            "type": "string",
            "enum": [
              "maf",
              "rhai"
            ]
          },
          "flags": [
            "--backend"
          ]
        },
        "target": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [
            "--target"
          ],
          "path": true
        },
        "name": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [
            "--name"
          ]
        }
      },
      "suffix": [],
      "cli_path": [
        "native",
        "scaffold"
      ],
      "description": "Use the real scaffold for a MAF/Rhai source; native execution remains separately observed."
    },
    "native_inspect": {
      "entrypoint": "scripts/flowify.py",
      "prefix": [
        "inspect"
      ],
      "parameters": {
        "backend": {
          "schema": {
            "type": "string",
            "enum": [
              "maf",
              "rhai"
            ]
          },
          "flags": [
            "--backend"
          ]
        },
        "file": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [
            "--file"
          ],
          "path": true
        }
      },
      "suffix": [],
      "cli_path": [
        "native",
        "inspect"
      ],
      "description": "Use the real inspect for a MAF/Rhai source; native execution remains separately observed."
    },
    "native_check": {
      "entrypoint": "scripts/flowify.py",
      "prefix": [
        "check"
      ],
      "parameters": {
        "backend": {
          "schema": {
            "type": "string",
            "enum": [
              "maf",
              "rhai"
            ]
          },
          "flags": [
            "--backend"
          ]
        },
        "file": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [
            "--file"
          ],
          "path": true
        }
      },
      "suffix": [],
      "cli_path": [
        "native",
        "check"
      ],
      "description": "Use the real check for a MAF/Rhai source; native execution remains separately observed."
    }
  },
  "limits": [
    "Mechanical verification checks recorded facts and actual retained bytes; a recorded semantic inspection is not authenticated judgment.",
    "Compilation and fixture success do not prove complete semantic workflow performance or provider/native-host activation.",
    "Use the actual native MAF/Rhai runtime to build and execute the workflow. Source inspection and report coverage do not establish execution."
  ]
}
