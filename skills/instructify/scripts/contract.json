{
  "version": 1,
  "name": "instructify",
  "purpose": "Plan hashed scoped instruction updates, preserving foreign content and actual loading boundaries.",
  "criteria": [
    {
      "id": "scope",
      "description": "Resolve the actual inherited scope, imports and intended instruction trigger."
    },
    {
      "id": "ownership",
      "description": "Preserve foreign content and installer ownership; compare hashed input before writing."
    },
    {
      "id": "native-binding",
      "description": "Verify file binding separately from observed native host loading."
    }
  ],
  "facts_schema": {
    "type": "object",
    "properties": {
      "ownership_preserved": {
        "type": "boolean",
        "const": true
      },
      "stale_input_applied": {
        "type": "boolean",
        "const": false
      },
      "scope_preserved": {
        "type": "boolean",
        "const": true
      }
    },
    "required": [
      "ownership_preserved",
      "stale_input_applied",
      "scope_preserved"
    ],
    "additionalProperties": false
  },
  "native": {
    "native_plan": {
      "entrypoint": "scripts/instructify.py",
      "prefix": [
        "plan"
      ],
      "parameters": {
        "project": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [
            "--project"
          ],
          "default": ".",
          "path": true
        },
        "input": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [
            "--input"
          ],
          "path": true
        }
      },
      "suffix": [],
      "cli_path": [
        "native",
        "plan"
      ],
      "description": "Use the existing instruction plan with hashed ownership/stale-plan checks."
    },
    "native_check": {
      "entrypoint": "scripts/instructify.py",
      "prefix": [
        "check"
      ],
      "parameters": {
        "project": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [
            "--project"
          ],
          "default": ".",
          "path": true
        },
        "input": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [
            "--input"
          ],
          "path": true
        }
      },
      "suffix": [],
      "cli_path": [
        "native",
        "check"
      ],
      "description": "Use the existing instruction check with hashed ownership/stale-plan checks."
    },
    "native_apply": {
      "entrypoint": "scripts/instructify.py",
      "prefix": [
        "apply"
      ],
      "parameters": {
        "project": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [
            "--project"
          ],
          "default": ".",
          "path": true
        },
        "plan": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [
            "--plan"
          ],
          "path": true
        },
        "dry_run": {
          "schema": {
            "type": "boolean"
          },
          "flags": [
            "--dry-run"
          ],
          "default": true
        }
      },
      "suffix": [],
      "cli_path": [
        "native",
        "apply"
      ],
      "description": "Use the existing instruction apply with hashed ownership/stale-plan checks."
    }
  },
  "limits": [
    "Mechanical verification checks recorded facts and actual retained bytes; a recorded semantic inspection is not authenticated judgment.",
    "Compilation and fixture success do not prove complete semantic workflow performance or provider/native-host activation.",
    "Use the native hashed plan/check/apply path for ownership and stale-plan enforcement; actual harness loading remains separately observed."
  ]
}
