{
  "version": 1,
  "name": "codify",
  "purpose": "Lower meaning once, verify native behavior and execute the retained compiled artifact.",
  "criteria": [
    {
      "id": "native-outcome",
      "description": "Exercise the native implementation on reproduction, transfer and rejection cases."
    },
    {
      "id": "artifact-freshness",
      "description": "Bind command/source/case bytes to a current executable artifact and reject stale input."
    },
    {
      "id": "inference-boundary",
      "description": "Execute code on reuse; declare any residual model/provider/harness inference explicitly."
    }
  ],
  "facts_schema": {
    "type": "object",
    "properties": {
      "actual_code_verified": {
        "type": "boolean",
        "const": true
      },
      "frozen_artifact_current": {
        "type": "boolean",
        "const": true
      },
      "implicit_inference": {
        "type": "boolean",
        "const": false
      }
    },
    "required": [
      "actual_code_verified",
      "frozen_artifact_current",
      "implicit_inference"
    ],
    "additionalProperties": false
  },
  "native": {
    "native_check": {
      "entrypoint": "scripts/codify.py",
      "prefix": [
        "check"
      ],
      "parameters": {
        "target": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [],
          "path": true
        }
      },
      "suffix": [],
      "cli_path": [
        "native",
        "check"
      ],
      "description": "Read-only validation using the existing codify helper."
    },
    "native_scaffold": {
      "entrypoint": "scripts/codify.py",
      "prefix": [
        "scaffold"
      ],
      "parameters": {
        "source": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [],
          "path": true
        },
        "target": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [
            "--target"
          ],
          "path": true
        },
        "backend": {
          "schema": {
            "type": "string",
            "enum": [
              "python",
              "ai-sdk"
            ]
          },
          "flags": [
            "--backend"
          ],
          "default": "python"
        }
      },
      "suffix": [],
      "cli_path": [
        "native",
        "scaffold"
      ],
      "description": "Create a draft with the actual codify generator; refuses an existing target."
    },
    "native_compile": {
      "entrypoint": "scripts/codify.py",
      "prefix": [
        "compile"
      ],
      "parameters": {
        "source": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [],
          "path": true
        },
        "entrypoint": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [
            "--entrypoint"
          ],
          "path": true
        },
        "cases": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [
            "--cases"
          ],
          "path": true
        },
        "root": {
          "schema": {
            "type": [
              "string",
              "null"
            ]
          },
          "flags": [
            "--root"
          ],
          "path": true,
          "default": null
        },
        "output": {
          "schema": {
            "type": [
              "string",
              "null"
            ]
          },
          "flags": [
            "--output"
          ],
          "path": true,
          "default": null
        },
        "include": {
          "schema": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "flags": [
            "--include"
          ],
          "path": true,
          "repeat": true,
          "default": []
        },
        "config": {
          "schema": {
            "type": [
              "string",
              "null"
            ]
          },
          "flags": [
            "--config"
          ],
          "path": true,
          "default": null
        },
        "project": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [
            "--project"
          ],
          "path": true,
          "default": "."
        },
        "profile": {
          "schema": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "flags": [
            "--profile"
          ],
          "repeat": true,
          "default": []
        },
        "dependencies": {
          "schema": {
            "type": [
              "string",
              "null"
            ]
          },
          "flags": [
            "--dependencies"
          ],
          "path": true,
          "default": null
        },
        "jobs": {
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "flags": [
            "--jobs"
          ],
          "default": 4
        },
        "dry_run": {
          "schema": {
            "type": "boolean"
          },
          "flags": [
            "--dry-run"
          ],
          "default": false
        }
      },
      "suffix": [],
      "cli_path": [
        "native",
        "compile"
      ],
      "description": "Compile supplied native code and actual contract cases with the existing codify compiler. Cases can execute their declared effects/inference; retain actual authorization and explicit profiles."
    },
    "native_run": {
      "entrypoint": "scripts/codify.py",
      "prefix": [
        "run"
      ],
      "parameters": {
        "artifact": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [],
          "path": true
        },
        "input": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [
            "--input"
          ],
          "path": true
        },
        "project": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "flags": [
            "--project"
          ],
          "path": true,
          "default": "."
        },
        "config": {
          "schema": {
            "type": [
              "string",
              "null"
            ]
          },
          "flags": [
            "--config"
          ],
          "path": true,
          "default": null
        },
        "dependencies": {
          "schema": {
            "type": [
              "string",
              "null"
            ]
          },
          "flags": [
            "--dependencies"
          ],
          "path": true,
          "default": null
        },
        "timeout": {
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          },
          "flags": [
            "--timeout"
          ],
          "default": 30
        }
      },
      "suffix": [],
      "cli_path": [
        "native",
        "run"
      ],
      "description": "Run the explicitly selected verified artifact through the native Codify runtime; preserves its declared code effects and model/profile configuration."
    }
  },
  "limits": [
    "Mechanical verification checks recorded facts and actual retained bytes; a recorded semantic inspection is not authenticated judgment.",
    "Compilation and fixture success do not prove complete semantic workflow performance or provider/native-host activation.",
    "Contract verification does not replace actual compile/check/run outcomes or establish semantic equivalence of arbitrary Markdown."
  ]
}
