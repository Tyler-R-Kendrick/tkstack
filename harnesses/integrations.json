    },
    "headroom": {
      "type": "stdio",
      "tool": "headroom",
      "args": [
        "mcp",
        "serve"
      ],
      "notes": "Requires its local proxy for CCR operations; proxy routing is explicit."
    },
    "open-design": {
      "type": "stdio",
      "tool": "open-design",
      "args": [
        "mcp",
        "--daemon-url",
        "http://127.0.0.1:7456"
      ]
    },
    "openwiki": {
      "type": "stdio",
      "tool": "openwiki",
      "args": [
        "mcp"
      ],
      "args_by_harness": {
        "codex": [
          "mcp",
          "--host",
          "codex"
        ],
        "claude": [
          "mcp",
          "--host",
          "claude"
        ],
        "cursor": [
          "mcp",
          "--host",
          "cursor"
        ]
      },
      "documentation": "https://github.com/langchain-ai/openwiki#coding-agent-integrations"
    },
